{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chat Slide Studio - human-reviewed visual storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deck_id",
    "title",
    "requested_slide_count",
    "slides"
  ],
  "properties": {
    "deck_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,55}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "requested_slide_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 80,
      "description": "Unique logical slide count, not physical slideshow pages with repeated hub visits."
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "layout",
          "title",
          "takeaway",
          "composition",
          "visual",
          "content_units",
          "reveal_sequence",
          "morph_from_previous"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "layout": {
            "enum": [
              "cover",
              "section",
              "cards",
              "timeline",
              "split",
              "diagram",
              "comparison",
              "quote",
              "summary",
              "thanks",
              "contents",
              "chart"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "takeaway": {
            "type": "string",
            "minLength": 4
          },
          "composition": {
            "type": "string",
            "minLength": 10,
            "description": "Exact intended hierarchy, columns and major blocks."
          },
          "visual": {
            "type": "string",
            "minLength": 4,
            "description": "Photo/diagram/figure selection and placement."
          },
          "content_units": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "reveal_sequence": {
            "type": "array",
            "items": {
              "enum": [
                "static",
                "auto",
                "click"
              ]
            },
            "maxItems": 10,
            "description": "The complete animation plan for presenter-controlled content units."
          },
          "morph_from_previous": {
            "type": "boolean"
          },
          "morph_reason": {
            "type": "string",
            "description": "Why a single named subject continues into this slide; include source and destination framing."
          },
          "closing_style": {
            "enum": [
              "plain",
              "creative"
            ],
            "description": "Creative closing may only be used after explicit approval."
          },
          "no_animation_reason": {
            "type": "string",
            "minLength": 16,
            "description": "Explicit narrative reason why multiple content units are all visible immediately"
          },
          "diagram_relationship": {
            "enum": [
              "peers",
              "hierarchy",
              "reciprocal"
            ],
            "description": "Semantic relationship shown by a conceptual diagram: equal peers (no direction), parent-to-child hierarchy, or two-way reciprocal interaction. Only for diagram slides; must agree with the approved storyboard."
          },
          "toc_entries": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "image",
                "morph_id",
                "target_slide"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 2
                },
                "image": {
                  "type": "string",
                  "minLength": 1
                },
                "morph_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,39}$"
                },
                "target_slide": {
                  "type": "integer",
                  "minimum": 3
                }
              }
            }
          },
          "chart_kind": {
            "enum": [
              "bar",
              "line",
              "pie"
            ],
            "description": "A data-backed chart with traceable numeric source; no invented data."
          },
          "morph_subject": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,39}$",
            "description": "Stable semantic image identifier shared with a TOC entry. For hub Morph, the content slide must use the same picture asset and morph_id."
          }
        }
      }
    },
    "tier": {
      "enum": [
        "content",
        "presenter",
        "studio"
      ],
      "description": "Pick by user need, do not force animation for every presentation."
    },
    "animation_mode": {
      "enum": [
        "none",
        "presenter"
      ],
      "description": "Effective animation behavior; must match approved deck."
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "hub_slide",
        "return_after"
      ],
      "properties": {
        "mode": {
          "const": "hub_return"
        },
        "hub_slide": {
          "type": "integer",
          "minimum": 2
        },
        "return_after": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 3
          }
        },
        "morph": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
