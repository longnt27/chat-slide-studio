{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/chat-slide-studio/deck.schema.json",
  "title": "Chat Slide Studio - presentation specification",
  "type": "object",
  "required": [
    "id",
    "title",
    "requested_slide_count",
    "slides"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,55}$"
    },
    "title": {
      "type": "string",
      "minLength": 6
    },
    "language": {
      "type": "string",
      "default": "vi"
    },
    "audience": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "theme": {
      "type": "object",
      "properties": {
        "preset": {
          "enum": [
            "heritage",
            "modern",
            "science"
          ]
        },
        "background": {
          "$ref": "#/$defs/hex"
        },
        "panel": {
          "$ref": "#/$defs/hex"
        },
        "primary": {
          "$ref": "#/$defs/hex"
        },
        "secondary": {
          "$ref": "#/$defs/hex"
        },
        "accent": {
          "$ref": "#/$defs/hex"
        },
        "text": {
          "$ref": "#/$defs/hex"
        },
        "muted": {
          "$ref": "#/$defs/hex"
        },
        "heading_font": {
          "type": "string"
        },
        "body_font": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "morph_to_slides": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 2
      },
      "uniqueItems": true,
      "default": [],
      "description": "Logical slide destinations of ordinary Morph transitions; TOC hub-to-content and return Morph is compiled separately into physical destinations."
    },
    "requested_slide_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 80,
      "description": "Number of unique logical slides, including cover, TOC and thanks; repeated TOC visits are additional physical PPTX/PDF pages recorded in slide-route.json."
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "$ref": "#/$defs/slide"
      }
    },
    "tier": {
      "type": "string",
      "enum": [
        "basic",
        "studio",
        "pro"
      ],
      "description": "Basic: static; Studio: presenter-controlled reveals; Pro: premium composition, data charts, optional chapter hub."
    },
    "animation_mode": {
      "enum": [
        "none",
        "presenter"
      ],
      "description": "Override tier animation defaults. none disables all entrances/transitions; presenter enables approved semantic reveals and selective Morph."
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "hub_slide",
        "return_after"
      ],
      "properties": {
        "mode": {
          "const": "hub_return"
        },
        "hub_slide": {
          "type": "integer",
          "minimum": 2
        },
        "return_after": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 3
          }
        },
        "morph": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "branch": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9/_-]+$",
      "description": "Dedicated Git branch for this deck (not main); keep independent decks on distinct branches and slugs."
    },
    "design": {
      "type": "object",
      "description": "User-selected visual direction. Color drives visible accents (contrast-adjusted) and style informs composition and base typography.",
      "properties": {
        "primary_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Brand color in #RRGGBB format"
        },
        "style": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "description": "Visual style description such as Swiss minimalist, editorial, corporate or academic. Implement composition in addition to metadata."
        }
      },
      "required": [
        "primary_color",
        "style"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#?[0-9A-Fa-f]{6}$"
    },
    "reveal": {
      "type": "string",
      "enum": [
        "auto",
        "click",
        "static"
      ]
    },
    "asset": {
      "type": "string",
      "minLength": 1
    },
    "card": {
      "type": "object",
      "required": [
        "title",
        "text"
      ],
      "properties": {
        "badge": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "$ref": "#/$defs/asset"
        },
        "morph_id": {
          "type": "string"
        },
        "reveal": {
          "$ref": "#/$defs/reveal"
        }
      },
      "additionalProperties": false
    },
    "slide": {
      "type": "object",
      "required": [
        "type",
        "title",
        "notes"
      ],
      "properties": {
        "type": {
          "enum": [
            "cover",
            "section",
            "cards",
            "timeline",
            "split",
            "diagram",
            "comparison",
            "quote",
            "summary",
            "thanks",
            "contents",
            "chart"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "eyebrow": {
          "type": "string"
        },
        "closing_style": {
          "enum": [
            "plain",
            "creative"
          ]
        },
        "subtitle": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "minLength": 15
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "image": {
          "$ref": "#/$defs/asset"
        },
        "image_side": {
          "enum": [
            "left",
            "right"
          ]
        },
        "image_mode": {
          "enum": [
            "preserve",
            "cover"
          ]
        },
        "decorative": {
          "type": "boolean"
        },
        "image_reveal": {
          "$ref": "#/$defs/reveal"
        },
        "morph_id": {
          "type": "string"
        },
        "cards": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "events": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "bullets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "root": {
          "type": "string"
        },
        "group_label": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "items": {
            "type": "string"
          }
        },
        "bottom": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/card"
        },
        "right": {
          "$ref": "#/$defs/card"
        },
        "quote": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "diagram_relationship": {
          "enum": [
            "peers",
            "hierarchy",
            "reciprocal"
          ],
          "description": "Semantic relationship shown by a conceptual diagram: equal peers (no direction), parent-to-child hierarchy, or two-way reciprocal interaction. Only for diagram slides; must agree with the approved storyboard."
        },
        "entries": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "image",
              "morph_id",
              "target_slide"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 2
              },
              "text": {
                "type": "string"
              },
              "image": {
                "$ref": "#/$defs/asset"
              },
              "morph_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,39}$"
              },
              "target_slide": {
                "type": "integer",
                "minimum": 3
              }
            }
          }
        },
        "chart_data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "labels",
            "series",
            "source"
          ],
          "properties": {
            "kind": {
              "enum": [
                "bar",
                "line",
                "pie"
              ]
            },
            "labels": {
              "type": "array",
              "minItems": 2,
              "maxItems": 15,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "series": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "values"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "values": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 15,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            },
            "source": {
              "type": "string",
              "minLength": 5
            },
            "unit": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "y_axis_title": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
